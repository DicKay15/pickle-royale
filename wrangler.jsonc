{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pickle-royale",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-01",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Run the Worker FIRST for API + auth so browser navigations to
    // /auth/login reach the Worker (and redirect to Google) instead of
    // being captured by the SPA not-found handler. Everything else is
    // served as a static asset directly.
    // /demo is here for the same reason: it's a browser navigation that
    // must reach the Worker to mint a demo session before any HTML is served.
    "run_worker_first": ["/api/*", "/auth/*", "/demo"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pickle-royale",
      "database_id": "46173fbc-cb86-4b50-8a56-1fb094db6b2a"
    }
  ],
  // Weekly automated DB export (in addition to Cloudflare's built-in
  // 30-day point-in-time recovery). Runs Mondays 06:00 UTC.
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "pickle-royale-backups"
    }
  ],
  // Mondays 06:00 UTC = DB export. Daily 04:00 UTC = delete demo accounts
  // (and their groups) older than 24h.
  "triggers": {
    "crons": ["0 6 * * 1", "0 4 * * *"]
  },
  // Custom domain pickleball.dhrumilkherde.com is attached via the
  // Cloudflare API at deploy time — keeping `routes` here breaks
  // local asset serving in `wrangler dev` (root path 404s).
  "observability": {
    "enabled": true
  }
}
